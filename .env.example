# Copy to `.env` for local Compose / desktop runs (`.env` is gitignored).
# Inside Compose app containers, leave BANTER_DATABASE_URL unset to use the
# compose default (`postgres://banter:banter@postgres:5432/banter`).

# Postgres URL the desktop embedded server / banter-server binary uses.
# Host port must match BANTER_PG_PORT when talking to Compose Postgres from the host.
BANTER_DATABASE_URL=postgres://banter:banter@127.0.0.1:5432/banter

# Host port published by Compose for the postgres service (container stays 5432).
# Use 5433 (or another free port) when something else already owns 5432.
BANTER_PG_PORT=5432

# File bytes (avatars, banners, attachments, board assets). Unset = platform default.
# Windows: %LOCALAPPDATA%\Banter
# Linux: $XDG_DATA_HOME/Banter or ~/.local/share/Banter
# BANTER_DATA=

# Standalone banter-server listen (desktop embedded server always uses 127.0.0.1:3970).
BANTER_BIND=0.0.0.0
BANTER_PORT=3970

# Guild voice UDP, only when the SFU is not on the client's host network
# (Compose). Leave unset for the embedded server. Each slot has its own range.
# BANTER_UDP_MIN=40000
# BANTER_UDP_MAX=40049
# Address written into host ICE candidates. 127.0.0.1 for a local desktop.
# For clients off this LAN, set the host’s public/reachable IP and open the UDP
# range on the firewall — otherwise guild voice/Go Live works on-LAN only.
# BANTER_ADVERTISE_IP=127.0.0.1

# Optional TURN relay for off-LAN P2P (DM calls) and stubborn NATs. Clients pull
# this via GET /v1/ice after sign-in; set these on the *server* process.
# BANTER_STUN=stun:stun.l.google.com:19302
# BANTER_TURN=turn:turn.example.com:3478
# BANTER_TURN_USER=banter
# BANTER_TURN_PASSWORD=secret

# App image. Unset builds this checkout as banter-server:local.
# GHCR :latest is still version-1-test-8. To run that tag:
# BANTER_IMAGE=ghcr.io/snowedinowl/banter:version-1-test-8
# BANTER_PULL_POLICY=always
